# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Without these the app runs in demo mode:
# sample data, no sign-in. See README → "Connecting Supabase".
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role
# Server-only. Bypasses row level security — never prefix it with NEXT_PUBLIC_
# and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used for canonical URLs and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
